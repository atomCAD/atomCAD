{
  "comment": "Matching-only library. `mark` turns whichever carbon it matched into nitrogen, so a test can see the choice; `pair` has two before atoms 0.1 Å apart, close enough that both want the same workpiece atom.",
  "format": "atomcad-msops/3",
  "tools": [
    {
      "name": "probe",
      "note": "A bare probe: the whole tool model these fixtures need. Every operation here is `tip` and carries an empty tool side, so the frame is declared and never bound - none of these fixtures wires a tool.",
      "frame": [
        { "tag": "apex", "pos": [0.0, 0.0, 0.0] },
        { "tag": "a",    "pos": [1.45, 0.0, -3.17] },
        { "tag": "b",    "pos": [-0.73, 1.26, -3.17] },
        { "tag": "c",    "pos": [-0.73, -1.26, -3.17] }
      ]
    }
  ],
  "ops": [
    {
      "name": "mark",
      "method": "tip",
      "tool": { "type": "probe" },
      "before": { "atoms": [ { "id": 1, "el": "C", "pos": [0.0, 0.0, 0.0] } ], "bonds": [] },
      "after":  { "atoms": [ { "id": 1, "el": "N", "pos": [0.0, 0.0, 0.0] } ], "bonds": [] }
    },
    {
      "name": "pair",
      "method": "tip",
      "tool": { "type": "probe" },
      "before": {
        "atoms": [
          { "id": 1, "el": "C", "pos": [0.0, 0.0, 0.0] },
          { "id": 2, "el": "C", "pos": [0.0, 0.0, 0.1] }
        ],
        "bonds": []
      },
      "after": { "atoms": [], "bonds": [] }
    },
    {
      "name": "mark_any",
      "method": "tip",
      "tool": { "type": "probe" },
      "before": { "atoms": [ { "id": 1, "el": "*", "pos": [0.0, 0.0, 0.0] } ], "bonds": [] },
      "after":  { "atoms": [ { "id": 1, "el": "N", "pos": [0.0, 0.0, 0.0] } ], "bonds": [] }
    }
  ]
}
