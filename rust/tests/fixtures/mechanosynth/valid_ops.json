{
  "comment": "Field-coverage library for the parsing tests. Unknown keys at every level are ignored.",
  "format": "atomcad-msops/4",
  "tools": [
    {
      "name": "probe",
      "note": "A bare probe: the whole tool model these fixtures need. Every operation here is `tip` and carries an empty tool side, so the frame is declared and never bound - none of these fixtures wires a tool.",
      "frame": [
        { "tag": "apex", "pos": [0.0, 0.0, 0.0] },
        { "tag": "a",    "pos": [1.45, 0.0, -3.17] },
        { "tag": "b",    "pos": [-0.73, 1.26, -3.17] },
        { "tag": "c",    "pos": [-0.73, -1.26, -3.17] }
      ],
      "envelope": { "half_angle": 30.0, "radius": 2.0 }
    }
  ],
  "tolerance": 0.25,
  "ops": [
    {
      "name": "keep_only",
      "method": "tip",
      "reaction": { "target": [0.0, 0.0, 0.0], "tool": [0.0, 0.0, 1.5] },
      "tool": { "type": "probe" },
      "basis": "provenance field, never read by the engine",
      "before": {
        "atoms": [ { "id": 1, "el": "C", "pos": [0.0, 0.0, 0.0], "label": "ignored" } ],
        "bonds": []
      },
      "after": {
        "atoms": [ { "id": 1, "el": "C", "pos": [0.0, 0.0, 0.0] } ],
        "bonds": []
      }
    },
    {
      "name": "add_chain",
      "method": "tip",
      "reaction": { "target": [0.0, 0.0, 0.0], "tool": [0.0, 0.0, 1.5] },
      "tool": { "type": "probe" },
      "note": "exercises the wildcard, an added atom, a default bond order and an explicit one",
      "before": {
        "atoms": [ { "id": 1, "el": "*", "pos": [0.0, 0.0, 0.0] } ],
        "bonds": []
      },
      "after": {
        "atoms": [
          { "id": 1, "el": "*", "pos": [0.0, 0.0, 0.0] },
          { "id": 2, "el": "O", "pos": [0.0, 0.0, 1.4] },
          { "id": 3, "el": "N", "pos": [0.0, 0.0, 2.8] }
        ],
        "bonds": [ [1, 2], [2, 3, 2] ]
      }
    }
  ]
}
